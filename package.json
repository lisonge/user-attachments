{
  "name": "user-attachments",
  "version": "2.0.2",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "test": "node --test test/index.test.ts",
    "test:demo": "node test/demo.ts",
    "type-check": "tsc"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "homepage": "https://github.com/lisonge/user-attachments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lisonge/user-attachments.git"
  },
  "bugs": {
    "url": "https://github.com/lisonge/user-attachments/issues"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsdown": "0.22.7",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.5.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.0",
      "onFail": "error"
    }
  }
}
